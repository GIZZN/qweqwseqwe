{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "tauri-nextjs-app",
  "version": "0.1.0",
  "identifier": "com.mycompany.taurinextjsapp",
  "build": {
    "frontendDist": "../out",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "npm run dev"
  },
  "app": {
    "windows": [
      {
        "title": "Interview Assistant",
        "width": 420,
        "height": 590,
        "minWidth": 600,
        "minHeight": 400,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "transparent": true,
        "shadow": true,
        "maximizable": true
      }
    ],
    
    "security": {
      "csp": "default-src 'self' 'unsafe-inline' 'unsafe-eval' data: blob: https://diplom-chi-ten.vercel.app; img-src 'self' data: blob: https: http:; connect-src 'self' https://diplom-chi-ten.vercel.app https://openrouter.ai https://api.openai.com https://gptunnel.ru http://localhost:*"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
